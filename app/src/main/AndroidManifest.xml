<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Delivr fonctionne 100% hors ligne : aucune permission réseau n'est déclarée.
        Pas de permission caméra non plus : le scan passe par le SDK ML Kit
        Document Scanner (voir camera/DocumentScanner.kt), qui gère sa propre
        activité de capture dans le processus Google Play services — Delivr
        n'a jamais besoin d'accéder directement à la caméra (voir CLAUDE.md,
        « Key architectural decision: no CameraX, no OpenCV »).
    -->

    <application
        android:name=".DelivrApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Delivr">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Delivr">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
